```
rsi = calculate_rsi(prices, RSI_PERIOD)
ma_short = calculate_ma(prices, MA_SHORT)
ma_long = calculate_ma(prices, MA_LONG)
current_price = prices[-1]

if not rsi or not ma_short or not ma_long:
    return None

signal = None
reasons = []

# إشارة شراء
if rsi < RSI_OVERSOLD:
    reasons.append(f"RSI منخفض ({rsi}) - السوق مبالغ في البيع")
if ma_short > ma_long and prices[-2] <= calculate_ma(prices[:-1], MA_LONG):
    reasons.append(f"تقاطع MA صعودي")

if len(reasons) >= 1 and rsi < RSI_OVERSOLD:
    signal = "شراء"

# إشارة بيع
sell_reasons = []
if rsi > RSI_OVERBOUGHT:
    sell_reasons.append(f"RSI مرتفع ({rsi}) - السوق مبالغ في الشراء")
if ma_short < ma_long:
    sell_reasons.append(f"تقاطع MA هبوطي")

if rsi > RSI_OVERBOUGHT:
    signal = "بيع"
    reasons = sell_reasons

return {
    "symbol": symbol,
    "price": current_price,
    "rsi": rsi,
    "ma_short": round(ma_short, 4),
    "ma_long": round(ma_long, 4),
    "signal": signal,
    "reasons": reasons,
}
```

